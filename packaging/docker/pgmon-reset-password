#!/usr/bin/env bash
# Resets a pgmon login account's password inside the standalone container.
# Run via `docker exec`, e.g.:
#   docker exec -it <container> pgmon-reset-password
#   docker exec -it <container> pgmon-reset-password alice
#   echo 'newpassword' | docker exec -i <container> pgmon-reset-password admin
#
# No sudo/privilege-drop needed here, unlike the RPM/Linux-installer version
# of this tool -- everything in this container already runs as root, so
# this just calls app.create_user directly.
set -euo pipefail

ENV_FILE="/etc/pgmon/pgmon.env"
USERNAME="${1:-admin}"

die() { echo "ERROR: $*" >&2; exit 1; }

[[ -f "$ENV_FILE" ]] || die "Missing $ENV_FILE -- is pgmon actually running in this container?"

if [[ -t 0 ]]; then
    read -r -s -p "New password for '$USERNAME': " PASSWORD1; echo
    read -r -s -p "Confirm: " PASSWORD2; echo
    [[ "$PASSWORD1" == "$PASSWORD2" ]] || die "Passwords didn't match."
    PASSWORD="$PASSWORD1"
else
    IFS= read -r PASSWORD
fi
[[ -n "$PASSWORD" ]] || die "Password can't be empty."

cd /opt/pgmon
set -a
source "$ENV_FILE"
set +a

if printf '%s' "$PASSWORD" | python -m app.create_user "$USERNAME" - --update; then
    echo "Password updated for '$USERNAME'."
else
    printf '%s' "$PASSWORD" | python -m app.create_user "$USERNAME" -
    echo "No existing account named '$USERNAME' -- created it fresh as an admin."
fi
