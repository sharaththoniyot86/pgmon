#!/usr/bin/env bash
# Resets a pgmon login account's password on a standalone (non-Kubernetes)
# Linux install -- for when you're locked out and there's no `kubectl exec`
# to fall back on. If the named account doesn't exist yet, creates it fresh
# as an admin instead (covers losing every account, not just forgetting one
# password). Installed by install.sh as /usr/local/bin/pgmon-reset-password.
#
#   sudo pgmon-reset-password            # reset 'admin', prompts for the new password
#   sudo pgmon-reset-password alice      # reset (or create) a specific account
#   echo 'newpassword' | sudo pgmon-reset-password admin   # non-interactive
set -euo pipefail

APP_USER="pgmon"
INSTALL_DIR="/opt/pgmon"
ENV_FILE="/etc/pgmon/pgmon.env"
USERNAME="${1:-admin}"

die() { echo "ERROR: $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "Run as root (sudo pgmon-reset-password [username])."
[[ -x "$INSTALL_DIR/venv/bin/python" ]] || die "pgmon doesn't look installed at $INSTALL_DIR -- is this the right machine?"
[[ -f "$ENV_FILE" ]] || die "Missing $ENV_FILE."

if [[ -t 0 ]]; then
    read -r -s -p "New password for '$USERNAME': " PASSWORD1; echo
    read -r -s -p "Confirm: " PASSWORD2; echo
    [[ "$PASSWORD1" == "$PASSWORD2" ]] || die "Passwords didn't match."
    PASSWORD="$PASSWORD1"
else
    IFS= read -r PASSWORD
fi
[[ -n "$PASSWORD" ]] || die "Password can't be empty."

# A real helper script file, not an inline `sudo -u ... bash -c '...'`: same
# reasoning as install.sh's own create-user step -- sudo's handling of
# inline env/argv depends on sudoers policy this can't assume either way,
# and piping the password through stdin here (rather than argv) keeps it
# out of `ps` output for the duration of the call.
HELPER="$(mktemp)"
STATUS_FILE="$(mktemp)"
chmod 666 "$STATUS_FILE"   # mktemp defaults to 600 root-owned; $APP_USER needs to write to it
cat > "$HELPER" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd "$INSTALL_DIR"
set -a
source "$ENV_FILE"
set +a
# Read the password once here (stdin is a non-seekable pipe, so each of the
# two possible create_user invocations below needs its own fresh copy of it
# via a here-string -- can't just pass the same '-' stdin to both in turn).
IFS= read -r PW
if "$INSTALL_DIR/venv/bin/python" -m app.create_user "$USERNAME" - --update <<<"\$PW"; then
    echo updated > "$STATUS_FILE"
else
    "$INSTALL_DIR/venv/bin/python" -m app.create_user "$USERNAME" - <<<"\$PW"
    echo created > "$STATUS_FILE"
fi
EOF
chmod 755 "$HELPER"

if printf '%s\n' "$PASSWORD" | sudo -u "$APP_USER" "$HELPER"; then
    case "$(cat "$STATUS_FILE" 2>/dev/null)" in
        created) echo "No existing account named '$USERNAME' -- created it fresh as an admin." ;;
        *) echo "Password updated for '$USERNAME'." ;;
    esac
    rm -f "$HELPER" "$STATUS_FILE"
else
    rm -f "$HELPER" "$STATUS_FILE"
    die "Failed to set the password -- check 'journalctl -u pgmon' and that $ENV_FILE is intact."
fi
